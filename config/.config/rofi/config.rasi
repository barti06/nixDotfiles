configuration {
  modi: "drun,powermenu:~/.config/rofi/powermenu.sh";
  show-icons: false;
  sidebar-mode: true;
  display-drun: "󰀻 Apps";
  display-powermenu: "󰐥 Power";
  timeout {
      action: "kb-cancel";
      delay:  0;
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}

/* =============================================================================
 * Rofi Theme - Tokyo Night (Dark Blues & Light Grays)
 * ============================================================================= */

* {
    /* Dark Blues */
    bg-dark:       rgba(22, 22, 30, 0.95);     /* 0.95 opacity (0.05 transparency) */
    bg-surface:    rgba(31, 35, 53, 0.95);     /* 0.95 opacity */
    bg-selected:   #283457;                    /* Tokyo Night selection dark blue */
    border-dark:   #3b4261;                    /* Steel blue-gray border */
    blue-accent:   #7aa2f7;                    /* Soft ice blue accent */

    /* Light Grays */
    fg:            #c0caf5;      /* Primary light gray / silver */
    fg-dim:        #a9b1d6;      /* Secondary light gray */
    fg-muted:      #565f89;      /* Slate gray for placeholders */
    fg-bright:     #ffffff;      /* Highlighted white */

    font:              "Iosevka Nerd 16";
    background-color:  transparent;
    text-color:        @fg;
    margin:            0px;
    padding:           0px;
    spacing:           0px;
}

window {
    location:          north;
    y-offset:          calc(50% - 176px);
    width:             500px;
    border-radius:     16px;
    border:            2px;
    border-color:      @border-dark;
    background-color:  @bg-dark;
}

mainbox {
    padding:    16px;
    spacing:    12px;
    children:   [ inputbar, message, listview, sidebar ];
}

inputbar {
    background-color:  @bg-surface;
    border-color:      @border-dark;
    border:            1px;
    border-radius:     10px;
    padding:           8px 14px;
    spacing:           10px;
    children:          [ prompt, entry ];
}

prompt {
    text-color: @blue-accent;
    font:       "Iosevka Nerd Bold 16";
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @fg-muted;
    text-color:         @fg;
}

message {
    margin:            8px 0 0;
    border-radius:     8px;
    border:            1px;
    border-color:      @border-dark;
    background-color:  @bg-surface;
}

textbox {
    padding:    8px 14px;
    text-color: @fg;
}

listview {
    background-color:  transparent;
    margin:            4px 0 0;
    spacing:           4px;
    lines:             8;
    columns:           1;
    fixed-height:      true;
}

scrollbar {
    handle-color:      @blue-accent;
    handle-width:      4px;
    background-color:  @bg-surface;
    border-radius:     4px;
    margin:            0 0 0 8px;
}

element {
    padding:           8px 14px;
    spacing:           10px;
    border-radius:     8px;
    background-color:  transparent;
    text-color:        @fg-dim;
    border:            1px;
    border-color:      transparent;
}

element normal normal, element alternate normal {
    background-color:  transparent;
    text-color:        @fg-dim;
}

element normal active, element alternate active {
    background-color:  @bg-surface;
    text-color:        @blue-accent;
}

element selected normal, element selected active {
    background-color:  @bg-selected;
    text-color:        @fg-bright;
    border-color:      @blue-accent;
}

element-icon, element-text {
    background-color:  transparent;
    text-color:        inherit;
}

sidebar {
    border:            1px 0 0;
    border-color:      @border-dark;
    background-color:  transparent;
    padding:           12px 0 0;
    spacing:           8px;
}

button {
    padding:           8px 16px;
    border-radius:     8px;
    text-color:        @fg-dim;
    background-color:  @bg-surface;
    border:            1px;
    border-color:      @border-dark;
    cursor:            pointer;
}

button selected {
    background-color:  @bg-selected;
    text-color:        @fg-bright;
    border-color:      @blue-accent;
}
